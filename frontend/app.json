{
  "expo": {
    "name": "Locals",
    "slug": "Locals",
    "version": "5.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "locals",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Locals1.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Locals uses your location to show nearby stores and deliver orders to your address.",
        "NSCameraUsageDescription": "Locals uses your camera to allow taking product and profile photos.",
        "NSPhotoLibraryUsageDescription": "Locals accesses your photo library to select product and profile photos.",
        "NSMicrophoneUsageDescription": "Locals uses your microphone for optional voice search features."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#FFD21F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.Locals1.app",
      "versionCode": 52,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBQZGl5wZhCM06tJa6lDLjwc3pFS0QP9J8"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Locals to access your location while using the app to show nearby stores.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD21F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Locals to access your photos to upload product and profile images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFD21F",
          "dark": {
            "backgroundColor": "#FFD21F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5458c1bc-f1c7-4685-aec3-051a003ede34"
      }
    },
    "owner": "mdshahidwithlov",
    "updates": {
      "url": "https://u.expo.dev/5458c1bc-f1c7-4685-aec3-051a003ede34",
      "checkAutomatically": "NEVER",
      "enabled": false
    }
  }
}
