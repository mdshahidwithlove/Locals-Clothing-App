# ================================
# SERVER CONFIGURATION
# ================================
PORT=3000

# ================================
# DATABASE CONFIGURATION
# ================================
# MongoDB connection string
# Example: mongodb://localhost:27017/locals
# Example (Atlas): mongodb+srv://username:password@cluster.mongodb.net/locals
DB_URL=mongodb://localhost:27017/locals

# ================================
# JWT AUTHENTICATION
# ================================
# Secret key for JWT token signing (use a strong random string)
# Generate using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Secret key for Admin JWT token signing (use a different strong random string)
# Generate using: openssl rand -base64 32
JWT_ADMIN_SECRET=your-super-secret-admin-jwt-key-change-this-in-production

# ================================
# RAZORPAY PAYMENT GATEWAY
# ================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Webhook secret for payment verification
# Get from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ================================
# SMS OTP SERVICE (2Factor.in)
# ================================
# Get your API key from: https://2factor.in/
TWO_FACTOR_API_KEY=your_2factor_api_key

# ================================
# FILE STORAGE (Supabase Storage)
# ================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_BUCKET_NAME=locals-bucket

# Merchants/delivery created before this date skip document verification (ISO 8601)
# VERIFICATION_REQUIRED_SINCE=2026-06-12T00:00:00.000Z

# ================================
# GOOGLE MAPS API (for geocoding & delivery assignment)
# ================================
# Required for address-to-coordinates conversion (proximity-based delivery assignment)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ================================
# NOTES
# ================================
# 1. Never commit the actual .env file to version control
# 2. Keep .env in .gitignore
# 3. For production, use strong random strings for all secrets
# 4. Rotate secrets regularly for better security
# 5. Use environment-specific values (dev, staging, production)
